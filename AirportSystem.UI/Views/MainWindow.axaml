<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AirportSystem.UI.ViewModels"
        xmlns:models="using:AirportSystem.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1180" d:DesignHeight="780"
        x:Class="AirportSystem.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Sistema de Gestión Aeroportuaria"
        Width="1180" Height="780"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#374151"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#F9FAFB"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="#111827" Padding="14,10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="#F9FAFB"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>
        <Button Grid.Column="1"
                Content="Guardar datos"
                Command="{Binding SaveCommand}"
                Margin="12,0,0,0"/>
      </Grid>
    </Border>

    <TabControl Margin="10">
      <!-- ==================== VUELOS ==================== -->
      <TabItem Header="Vuelos">
        <Grid ColumnDefinitions="3*,2*" Margin="6">
          <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Margin="0,0,12,0">
            <Border Grid.Row="0" Classes="card">
              <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto" ColumnSpacing="6">
                <TextBlock Text="Origen" Classes="label"/>
                <TextBox Grid.Column="1" Text="{Binding SearchOrigin}" PlaceholderText="IST"/>
                <TextBlock Grid.Column="2" Text="Destino" Classes="label" Margin="8,0,0,0"/>
                <TextBox Grid.Column="3" Text="{Binding SearchDestination}" PlaceholderText="JFK"/>
                <Button Grid.Column="4" Content="Buscar"
                        Command="{Binding SearchFlightsCommand}" Margin="8,0,0,0"/>
                <Button Grid.Column="5" Content="Ver todos"
                        Command="{Binding ShowAllFlightsCommand}" Margin="6,0,0,0"/>
              </Grid>
            </Border>

            <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,10,0,0">
              <Grid ColumnDefinitions="80,130,130,90,80,110" Margin="12,4">
                <TextBlock Text="Vuelo" Classes="label"/>
                <TextBlock Grid.Column="1" Text="Ruta" Classes="label"/>
                <TextBlock Grid.Column="2" Text="Salida" Classes="label"/>
                <TextBlock Grid.Column="3" Text="Estado" Classes="label"/>
                <TextBlock Grid.Column="4" Text="Asientos" Classes="label"/>
                <TextBlock Grid.Column="5" Text="Puerta / Term." Classes="label"/>
              </Grid>
              <ListBox Grid.Row="1"
                       x:Name="FlightsList"
                       ItemsSource="{Binding Flights}"
                       SelectedItem="{Binding SelectedFlight}"
                       AutoScrollToSelectedItem="True"
                       SelectionChanged="OnFlightsSelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:Flight">
                    <Grid ColumnDefinitions="80,130,130,90,80,110">
                      <TextBlock Text="{Binding FlightNumber}" FontWeight="SemiBold"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding Origin}"/>
                        <TextBlock Text="→"/>
                        <TextBlock Text="{Binding Destination}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2"
                                 Text="{Binding DepartureTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/>
                      <TextBlock Grid.Column="3" Text="{Binding Status}"/>
                      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="{Binding AvailableSeats}"/>
                        <TextBlock Text="/"/>
                        <TextBlock Text="{Binding TotalSeats}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding Gate}"/>
                        <TextBlock Text="/"/>
                        <TextBlock Text="{Binding Terminal}"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>

            <Border Grid.Row="2" Classes="card" Margin="0,10,0,0">
              <Grid RowDefinitions="Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Mapa de asientos" Classes="title"/>
                  <TextBlock Text="(X = ocupado, . = libre)"
                             Foreground="#6B7280" VerticalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Height="190"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,6,0,0">
                  <TextBlock Text="{Binding SeatMapDisplay}"
                             FontFamily="Consolas,Cascadia Mono,monospace"
                             FontSize="13"/>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>

          <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10">
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="Registrar nuevo vuelo" Classes="title"/>
                  <Grid ColumnDefinitions="115,*"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                        RowSpacing="4" ColumnSpacing="8">
                    <TextBlock Grid.Row="0" Text="N° de vuelo" Classes="label"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewFlightNumber}" PlaceholderText="TK001"/>

                    <TextBlock Grid.Row="1" Text="Aerolínea" Classes="label"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewAirline}" PlaceholderText="Turkish Airlines"/>

                    <TextBlock Grid.Row="2" Text="Origen" Classes="label"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NewOrigin}" PlaceholderText="IST"/>

                    <TextBlock Grid.Row="3" Text="Destino" Classes="label"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding NewDestination}" PlaceholderText="JFK"/>

                    <TextBlock Grid.Row="4" Text="Salida" Classes="label"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding NewDeparture}" PlaceholderText="yyyy-MM-dd HH:mm"/>

                    <TextBlock Grid.Row="5" Text="Llegada" Classes="label"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding NewArrival}" PlaceholderText="yyyy-MM-dd HH:mm"/>

                    <TextBlock Grid.Row="6" Text="Precio base" Classes="label"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding NewBasePrice}" PlaceholderText="450.00"/>

                    <TextBlock Grid.Row="7" Text="Puerta" Classes="label"/>
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding NewGate}" PlaceholderText="A12"/>

                    <TextBlock Grid.Row="8" Text="Terminal" Classes="label"/>
                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding NewTerminal}" PlaceholderText="1"/>

                    <TextBlock Grid.Row="9" Text="Filas de asientos" Classes="label"/>
                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding NewRows}" PlaceholderText="10"/>

                    <TextBlock Grid.Row="10" Text="Columnas" Classes="label"/>
                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding NewColumns}" PlaceholderText="ABCDEF"/>
                  </Grid>
                  <TextBlock Text="{Binding StatusMessage}"
                             Foreground="{Binding StatusBrush}"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap"/>
                  <Button Content="Registrar vuelo"
                          Command="{Binding RegisterFlightCommand}"
                          HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="Simulación de tiempo" Classes="title"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Avanzar (horas)" Classes="label"/>
                    <TextBox Text="{Binding AdvanceHours}" Width="90"/>
                    <Button Content="Avanzar" Command="{Binding AdvanceTimeCommand}"/>
                  </StackPanel>
                  <TextBlock Text="Actualiza automáticamente el estado de los vuelos."
                             Foreground="#6B7280" FontSize="12"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ==================== PASAJEROS ==================== -->
      <TabItem Header="Pasajeros">
        <Grid ColumnDefinitions="3*,2*" Margin="6">
          <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,12,0">
            <TextBlock Text="Pasajeros registrados" Classes="title" Margin="4"/>
            <Grid Grid.Row="1" RowDefinitions="Auto,*">
              <Grid ColumnDefinitions="50,180,230,140" Margin="12,4">
                <TextBlock Text="ID" Classes="label"/>
                <TextBlock Grid.Column="1" Text="Nombre" Classes="label"/>
                <TextBlock Grid.Column="2" Text="Email" Classes="label"/>
                <TextBlock Grid.Column="3" Text="Teléfono" Classes="label"/>
              </Grid>
              <ListBox Grid.Row="1"
                       x:Name="PassengersList"
                       ItemsSource="{Binding Passengers}"
                       SelectedItem="{Binding SelectedPassenger}"
                       AutoScrollToSelectedItem="True"
                       SelectionChanged="OnPassengersSelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:Passenger">
                    <Grid ColumnDefinitions="50,180,230,140">
                      <TextBlock Text="{Binding Id}"/>
                      <TextBlock Grid.Column="1" Text="{Binding FullName}" FontWeight="SemiBold"/>
                      <TextBlock Grid.Column="2" Text="{Binding Email}"/>
                      <TextBlock Grid.Column="3" Text="{Binding Phone}"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Grid>

          <ScrollViewer Grid.Column="1">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="Registrar pasajero" Classes="title"/>
                <TextBlock Text="Nombre" Classes="label"/>
                <TextBox Text="{Binding PassengerFirstName}" PlaceholderText="John"/>
                <TextBlock Text="Apellido" Classes="label"/>
                <TextBox Text="{Binding PassengerLastName}" PlaceholderText="Doe"/>
                <TextBlock Text="Email" Classes="label"/>
                <TextBox Text="{Binding PassengerEmail}" PlaceholderText="john@example.com"/>
                <TextBlock Text="Teléfono" Classes="label"/>
                <TextBox Text="{Binding PassengerPhone}" PlaceholderText="1234567890"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusBrush}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <Button Content="Registrar pasajero"
                        Command="{Binding RegisterPassengerCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,0"/>
                <TextBlock Text="Los pasajeros se guardan automáticamente."
                           Foreground="#6B7280" FontSize="12"/>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ==================== RESERVAS ==================== -->
      <TabItem Header="Reservas y check-in">
        <Grid RowDefinitions="Auto,*,Auto" Margin="6">
          <Border Classes="card">
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="8" RowSpacing="6">
              <TextBlock Text="Vuelo" Classes="label"/>
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding Flights}"
                        SelectedItem="{Binding SelectedFlight}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="models:Flight">
                    <TextBlock Text="{Binding FlightNumber}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Column="2" Text="Pasajero" Classes="label" Margin="8,0,0,0"/>
              <ComboBox Grid.Column="3"
                        ItemsSource="{Binding Passengers}"
                        SelectedItem="{Binding SelectedPassenger}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="models:Passenger">
                    <TextBlock Text="{Binding FullName}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Column="4" Text="Asiento" Classes="label" Margin="8,0,0,0"/>
              <ComboBox Grid.Column="5"
                        ItemsSource="{Binding AvailableSeats}"
                        SelectedItem="{Binding SelectedSeat}"
                        HorizontalAlignment="Stretch"/>
              <Button Grid.Column="6" Content="Reservar"
                      Command="{Binding BookTicketCommand}" Margin="8,0,0,0"/>
            </Grid>
          </Border>

          <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,10,0,0">
            <Grid ColumnDefinitions="70,100,200,80,100" Margin="12,4">
              <TextBlock Text="ID" Classes="label"/>
              <TextBlock Grid.Column="1" Text="Vuelo" Classes="label"/>
              <TextBlock Grid.Column="2" Text="Pasajero" Classes="label"/>
              <TextBlock Grid.Column="3" Text="Asiento" Classes="label"/>
              <TextBlock Grid.Column="4" Text="Estado" Classes="label"/>
            </Grid>
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Bookings}"
                     SelectedItem="{Binding SelectedBooking}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BookingRow">
                  <Grid ColumnDefinitions="70,100,200,80,100">
                    <TextBlock Text="{Binding BookingId}"/>
                    <TextBlock Grid.Column="1" Text="{Binding FlightNumber}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="{Binding Passenger}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Seat}"/>
                    <TextBlock Grid.Column="4" Text="{Binding Status}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <Button Content="Check-in" Command="{Binding CheckInCommand}"/>
            <Button Content="Cancelar reserva" Command="{Binding CancelBookingCommand}"/>
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
