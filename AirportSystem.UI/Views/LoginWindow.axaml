<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AirportSystem.UI"
        x:Class="AirportSystem.UI.Views.LoginWindow"
        Title="{DynamicResource LoginTitle}"
        Width="430" Height="470"
        MinWidth="430" MinHeight="470"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app-logo.png"
        KeyDown="OnKeyDown">

  <Border Background="#F9FAFB" Padding="28">
    <StackPanel Spacing="12" VerticalAlignment="Center">
      <ComboBox HorizontalAlignment="Right" Width="120"
                ItemsSource="{Binding Languages, Source={x:Static local:LocalizationService.Instance}}"
                SelectedItem="{Binding SelectedLanguage, Source={x:Static local:LocalizationService.Instance}}"/>
      <Image Source="/Assets/app-logo.png" Width="80" Height="80"
             Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
      <TextBlock Text="{DynamicResource AppTitle}"
                 FontSize="20" FontWeight="SemiBold" Foreground="#111827"
                 HorizontalAlignment="Center"/>
      <TextBlock Text="{DynamicResource LoginPrompt}" Foreground="#6B7280"
                 HorizontalAlignment="Center" Margin="0,0,0,8"/>

      <TextBlock Text="{DynamicResource User}" FontWeight="SemiBold" Foreground="#374151"/>
      <TextBox x:Name="UserBox" PlaceholderText="Admin" Height="36"/>

      <TextBlock Text="{DynamicResource Password}" FontWeight="SemiBold" Foreground="#374151"/>
      <TextBox x:Name="PasswordBox" PasswordChar="•" Height="36"/>

      <TextBlock x:Name="ErrorText" Text="" Foreground="#DC2626"
                 TextWrapping="Wrap" MinHeight="18"/>

      <StackPanel Orientation="Horizontal" Spacing="10"
                  HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button x:Name="CancelButton" Content="{DynamicResource Cancel}" Width="100"
                Click="OnCancelClick"/>
        <Button x:Name="LoginButton" Content="{DynamicResource SignIn}" Width="100"
                Classes="accent" Click="OnLoginClick"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
